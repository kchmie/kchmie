---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import PostCarousel from '../components/PostCarousel.astro';
import { AUTHOR_NAME, GITHUB_URL, ITCH_URL, LINKEDIN_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('blog', ({ data }) => !data.hidden)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const interests = [
  'Computer Science', 'Security', 'Local LLMs', 'Automation', 'Game Development', 'Music Production',
];
---
<!doctype html>
<html lang="en" id="top">
  <head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
  <body>
    <Header />
    <main id="main-content" class="home-main">
      <section id="about" class="hero" aria-labelledby="intro-title">
        <h1 id="intro-title">Hi, I'm {AUTHOR_NAME}.<br /><span>Curiosity drives me.</span></h1>
        <p class="hero-description">Computer Science student & software engineer.<br class="desktop-break" /> Building tools, exploring systems. Based in Poland.</p>
        <ul class="topic-list" aria-label="My interests">{interests.map((interest) => <li>{interest}</li>)}</ul>
      </section>
      <div class="home-bottom">
        <section id="writing" class="writing-section" aria-labelledby="writing-title">
          <div class="section-heading"><h2 id="writing-title">Blog</h2><a class="text-link" href={`${base}/blog/`}>All posts <Icon name="arrow-up-right" size={18} /></a></div>
          <p class="section-intro">Thoughts in progress. Notes from what I learn and build.</p>
          <PostCarousel posts={posts} />
        </section>
        <section id="links" class="links-section" aria-labelledby="links-title">
          <div class="section-heading"><h2 id="links-title">Elsewhere</h2><a class="text-link" href={`${base}/card/`}>Card <Icon name="arrow-up-right" size={18} /></a></div>
          <p class="section-intro">Code, games & more.</p>
          <div class="external-links">
            <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer"><Icon name="github" size={18} /><span>GitHub</span><Icon name="arrow-up-right" size={16} /></a>
            <a href={ITCH_URL} target="_blank" rel="noopener noreferrer"><Icon name="gamepad" size={18} /><span>itch.io</span><Icon name="arrow-up-right" size={16} /></a>
            {LINKEDIN_URL && <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer"><Icon name="link" size={18} /><span>LinkedIn</span><Icon name="arrow-up-right" size={16} /></a>}
          </div>
        </section>
      </div>
    </main>
    <Footer />
  </body>
</html>
