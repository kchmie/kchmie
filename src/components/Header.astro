---
import { GITHUB_URL, LINKEDIN_URL, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2 style="width:25%;"><a href={import.meta.env.BASE_URL}>{SITE_TITLE}</a></h2>
		<div class="internal-links" style="width:50%">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
		</div>
		<div class="social-links" style="width:25%">
			<a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
				<span class="sr-only">Visit my GitHub profile</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="28" height="28"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
			{LINKEDIN_URL && (<a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">
				<span class="sr-only">Visit my LinkedIn profile</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="28" height="28"
					><path
						fill="currentColor"
						d="M14.82 0H1.18C.528 0 0 .512 0 1.145v13.71C0 15.487.528 16 1.18 16h13.64c.652 0 1.18-.513 1.18-1.145V1.145C16 .512 15.472 0 14.82 0zM4.744 13.64H2.369V5.996h2.375v7.644zm-1.187-8.694h-.016c-.797 0-1.312-.548-1.312-1.234 0-.703.53-1.234 1.343-1.234.812 0 1.311.53 1.328 1.234 0 .686-.516 1.234-1.343 1.234zm10.083 8.694h-2.375V9.564c0-1.014-.363-1.706-1.269-1.706-.692 0-1.106.467-1.286.918-.066.161-.083.386-.083.612v4.253H6.253s.031-6.898 0-7.645h2.374v1.083c.315-.487.88-1.183 2.14-1.183 1.562 0 2.734 1.02 2.734 3.213v4.53z"
					></path></svg
				>
			</a>)}
		</div>
	</nav>
</header>
