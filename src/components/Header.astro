---
import { SITE_TITLE } from '../consts';
import AmbientBackdrop from './AmbientBackdrop.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isHome = Astro.url.pathname.replace(/\/$/, '') === base;
const home = `${base}/`;
---
<AmbientBackdrop />
<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
  <shrinking-navigation>
    <nav class="nav-shell" aria-label="Main navigation">
      <a class="wordmark" href={home} aria-label={`${SITE_TITLE} home`}>{SITE_TITLE}<span>.</span></a>
      <div class="nav-links">
        <a href={isHome ? '#about' : `${home}#about`}>About</a>
        <a href={`${base}/blog/`} aria-current={Astro.url.pathname.startsWith(`${base}/blog`) ? 'page' : undefined}>Blog</a>
        <a href={`${base}/card/`}>Links</a>
      </div>
    </nav>
  </shrinking-navigation>
</header>
<script>
  class ShrinkingNavigation extends HTMLElement {
    private cleanup?: () => void;
    connectedCallback() {
      const controller = new AbortController();
      let frame = 0;
      const update = () => {
        this.toggleAttribute('data-compact', window.scrollY > 64);
        frame = 0;
      };
      const schedule = () => { if (!frame) frame = requestAnimationFrame(update); };
      window.addEventListener('scroll', schedule, { passive: true, signal: controller.signal });
      update();
      this.cleanup = () => { controller.abort(); cancelAnimationFrame(frame); };
    }
    disconnectedCallback() { this.cleanup?.(); }
  }
  if (!customElements.get('shrinking-navigation')) customElements.define('shrinking-navigation', ShrinkingNavigation);
</script>
